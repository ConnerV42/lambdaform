[3.18, "o", "# Simple Lambda function for testing Lambdaform\r\n"]
[3.2, "o", "\r\n"]
[3.22, "o", "resource \"aws_lambda_function\" \"hello\" {\r\n"]
[3.24, "o", "  function_name = \"hello-world\"\r\n"]
[3.26, "o", "  handler       = \"index.handler\"\r\n"]
[3.28, "o", "  runtime       = \"nodejs20.x\"\r\n"]
[3.3, "o", "  timeout       = 30\r\n"]
[3.32, "o", "  memory_size   = 128\r\n"]
[3.34, "o", "\r\n"]
[3.36, "o", "  filename = \"lambda.zip\"\r\n"]
[3.38, "o", "\r\n"]
[3.4, "o", "  environment {\r\n"]
[3.42, "o", "    variables = {\r\n"]
[3.44, "o", "      GREETING = \"Hello from Lambdaform!\"\r\n"]
[3.46, "o", "      ENV      = \"local\"\r\n"]
[3.48, "o", "    }\r\n"]
[3.5, "o", "  }\r\n"]
[3.52, "o", "}\r\n"]
