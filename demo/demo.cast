[8.72, "o", "\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\n"]
[8.76, "o", "\u2502           \ud83d\ude80 Lambdaform v0.5.0          \u2502\r\n"]
[8.8, "o", "\u2502     Terraform-native Lambda emulator    \u2502\r\n"]
[8.84, "o", "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[8.88, "o", "\r\n"]
[8.92, "o", "\ud83d\udcc2 Loading Terraform from: ./\r\n"]
[8.96, "o", "\r\n"]
[9.0, "o", "\ud83d\udce6 Lambda Functions:\r\n"]
[9.04, "o", "   \u2022 hello-world (Nodejs20) \u2192 index.handler\r\n"]
[9.08, "o", "   \u2022 echo (Nodejs20) \u2192 echo.handler\r\n"]
[9.12, "o", "   \u2022 get-user (Nodejs20) \u2192 users.handler\r\n"]
[9.16, "o", "\r\n"]
[9.2, "o", "\ud83c\udf10 Routes:\r\n"]
[9.24, "o", "   GET  /hello      \u2192 hello-world\r\n"]
[9.28, "o", "   POST /echo       \u2192 echo\r\n"]
[9.32, "o", "   GET  /users/{id} \u2192 get-user\r\n"]
[9.36, "o", "\r\n"]
[9.4, "o", "\ud83d\udd25 Server running at \u001b[1;4mhttp://localhost:3000\u001b[0m\r\n"]
[9.44, "o", "\ud83d\udc40 Hot reload enabled \u2014 watching for changes\r\n"]
